# Gateway LLM (OpenAI-compatível — seu IGO OpenAI Gateway). Vazio = modo offline (testável).
MIND_LLM_BASE_URL=
MIND_LLM_API_KEY=
MIND_LLM_MODEL=gpt-4o-mini

# Raiz dos dados (grafo/ memoria/ permissoes/). Em dev local, deixe vazio (resolve subindo da pasta).
# No Docker, é setado para /data no compose.
MIND_DADOS=

# Fontes EXTRAS de memória (pastas com .md), separadas por vírgula. Ex.: a BASE_CONHECIMENTO da I GO.
# A memória própria da Mind (memoria/) tem precedência sobre estas.
MIND_MEMORIA_EXTRA=/Users/rafamacpro/Projetos/VBA-EXCEL/BASE_CONHECIMENTO/_md
